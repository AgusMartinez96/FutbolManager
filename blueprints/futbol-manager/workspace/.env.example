# Local development values only. Production never reads this file: Render injects real values.
# Bootstrap copies this file to .env (gitignored). Spring Boot loads .env through
# spring.config.import in application.yml; docker compose reads it natively.
DB_NAME=futbol
DB_USERNAME=futbol
DB_PASSWORD=futbol_local_dev
DB_URL=jdbc:postgresql://localhost:5433/futbol
# Only read when the "demo" profile is active (step 18 DemoDataSeeder).
DEMO_PASSWORD=demo_local_dev
